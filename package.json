{
  "name": "pau-dallochio-landing-page",
  "version": "1.2.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --port 4589",
    "start": "npm run dev",
    "prebuild": "node scripts/generate-env.mjs",
    "build": "ng build",
    "postbuild": "node scripts/generate-sitemap.mjs && node scripts/post-build-index.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "index-url": "node scripts/index-url.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --code-coverage",
    "test:watch": "ng test",
    "test:ci": "npm run test:prod",
    "test:coverage": "npm run test:prod",
    "lint": "eslint \"**/*.{ts,tsx}\" ",
    "lint:fix": "eslint --fix \"**/*.{ts,tsx}\" ",
    "build:prod": "ng build --configuration production && npm run postbuild",
    "test:prod": "ng test --browsers=ChromeHeadless --watch=false --code-coverage"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/google-maps": "^22.2.5",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@types/jasmine": "~5.1.15",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.7",
    "google-auth-library": "^11.3.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.13.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "prettier": "^3.9.10",
    "prettier-eslint": "^17.1.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "webpack-dev-middleware": "^7.4.6",
    "uuid": "^11.1.1"
  }
}
