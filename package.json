{
  "name": "pau-dallochio-landing-page",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --port 4589",
    "start": "npm run dev",
    "prebuild": "node scripts/generate-env.mjs",
    "build": "ng build",
    "postbuild": "node scripts/generate-sitemap.mjs && node scripts/post-build-index.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "index-url": "node scripts/index-url.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --code-coverage",
    "test:watch": "ng test",
    "test:ci": "npm run test:prod",
    "test:coverage": "npm run test:prod",
    "lint": "eslint \"**/*.{ts,tsx}\" ",
    "lint:fix": "eslint --fix \"**/*.{ts,tsx}\" ",
    "build:prod": "ng build --configuration production && npm run postbuild",
    "test:prod": "ng test --browsers=ChromeHeadless --watch=false --code-coverage"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.14",
    "@angular/common": "^18.2.14",
    "@angular/compiler": "^18.2.14",
    "@angular/core": "^18.2.14",
    "@angular/forms": "^18.2.14",
    "@angular/google-maps": "^17.0.4",
    "@angular/platform-browser": "^18.2.14",
    "@angular/platform-browser-dynamic": "^18.2.14",
    "@angular/router": "^18.2.14",
    "jspdf": "^2.5.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.14",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "google-auth-library": "^11.0.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.1.0",
    "prettier-eslint": "^16.1.2",
    "typescript": "~5.5.4"
  }
}
